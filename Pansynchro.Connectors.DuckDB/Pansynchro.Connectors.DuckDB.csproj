<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<AssemblyVersion>0.7.7</AssemblyVersion>
		<FileVersion>0.7.7</FileVersion>
		<Version>0.7.7</Version>
		<Authors>Pansynchro Technologies</Authors>
		<Product>Pansynchro DuckDB Connector</Product>
		<Description>Pansynchro connector to read from or write to DuckDB databases.</Description>
		<Copyright>Copyright 2026, Pansynchro Technologies</Copyright>
		<PackageProjectUrl>https://github.com/Pansynchro-Technologies/Pansynchro</PackageProjectUrl>
		<PackageTags>pansynchro;data;data-integration;etl;elt;duckdb</PackageTags>
		<PackageReleaseNotes>Initial release</PackageReleaseNotes>
		<PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
		<NoWarn>$(NoWarn);NU1605</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DuckDB.NET.Data" Version="1.5.5" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pansynchro.core\Pansynchro.Core.csproj" />
		<ProjectReference Include="..\Pansynchro.SQL\Pansynchro.SQL.csproj" />
	</ItemGroup>

</Project>
